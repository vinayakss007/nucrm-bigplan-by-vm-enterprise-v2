###############################################################################
#  NuCRM — Production Environment Variables
#  
#  VM Target: 8 GB RAM, 1 PostgreSQL, 1 Redis, 1 S3 (MinIO), 1 Email service
#  
#  INSTRUCTIONS:
#    1. Copy this file: cp deploy/.env.production .env
#    2. Fill in ALL values marked with <<<REQUIRED>>>
#    3. Generate secrets: bash deploy/generate-secrets.sh
#    4. Start: docker compose -f deploy/docker-compose.production.yml up -d
#
#  SECRET GENERATION (run once):
#    openssl rand -base64 64   → JWT_SECRET
#    openssl rand -base64 48   → SESSION_SECRET
#    openssl rand -hex 32      → ENCRYPTION_KEY
#    openssl rand -hex 24      → SETUP_KEY
#    openssl rand -hex 48      → CRON_SECRET
#    openssl rand -hex 32      → EMERGENCY_RECOVERY_KEY
###############################################################################

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 1: CORE APPLICATION                                             ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# #3279: the compose stack needs this set; `.env.example` ships `development` and the
# two only agree once an operator edits one of them. Everything fail-closed keys off it:
# the Secure-cookie forcing (#2275), ALLOW_DEMO_MODE gating
# (lib/auth/middleware.ts:62) and the SETUP_KEY gate on /api/setup/create-admin. A
# production box that runs with it unset serves live traffic with dev security
# behaviour, and nothing in the logs says so.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ── Public domain + TLS (#1040) ───────────────────────────────────────────────
# DOMAIN is the bare hostname served over HTTPS (no scheme, no path).
# deploy/scripts/setup-ssl.sh issues a real Let's Encrypt certificate for it.
# Leave DOMAIN empty (or set it to a bare IP) to fall back to a self-signed cert
# for IP-only testing — browsers will warn until a real DNS name is pointed here.
DOMAIN=crm.yourdomain.com
# Email Let's Encrypt uses for expiry notices (required to issue a real cert).
ACME_EMAIL=admin@yourdomain.com

# Your public-facing URL (no trailing slash). Must match DOMAIN + https.
# #3279: `.env.example` holds the dev origin (http://localhost:3000) and this holds the
# placeholder for the real one; the divergence is the two files' roles, not a mistake.
# It matters because `next build` inlines NEXT_PUBLIC_* into every client bundle, so a
# deploy built before this was edited carries the dev origin into production, and OAuth
# redirects and server-generated mail links follow it (#1040). prod:preflight fails a
# production process whose value is still http or loopback.
NEXT_PUBLIC_APP_URL=https://crm.yourdomain.com
# #3279: same divergence and same reason as the two above; this is the cross-origin
# allowlist, so whatever is copied from the dev template decides which origins a
# credentialed request from the browser is good for.
ALLOWED_ORIGINS=https://crm.yourdomain.com

# Cookie security (true for HTTPS, false for HTTP-only dev)
COOKIE_SECURE=true

# Client-IP source for rate limiting. MUST be true in this deployment: the app
# sits behind nginx, which overwrites X-Forwarded-For. Without it every client
# shares one 'unknown' rate-limit bucket (global lockouts).
# Only set true behind a proxy you control that sanitizes XFF.
# #3279: this is `false` in `.env.example` and `true` here, and the difference decides
# whether a fresh install can log in at all — getClientIp() (lib/client-ip.ts:15) answers
# 'unknown' unless the value is exactly 'true', and checkRateLimit then fails CLOSED with
# 503 for every auth-scoped action (lib/rate-limit.ts:442, #2630). The dev template stays
# false on purpose: with no proxy in front, true lets any client pick its own rate-limit
# bucket by sending X-Forwarded-For. Note that `true` here is enforced twice over —
# docker-compose.production.yml pins TRUST_PROXY=true in the container environment, which
# beats this file — so the compose path cannot regress, and only the host/pm2 path has to
# be checked. `npm run prod:preflight` does exactly that against the live process.
TRUST_PROXY=true

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 2: AUTHENTICATION & SECRETS                                     ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# JWT signing key — MINIMUM 64 chars, NEVER share
# Generate: openssl rand -base64 64
JWT_SECRET=<<<REQUIRED>>>

# Session encryption
# Generate: openssl rand -base64 48
SESSION_SECRET=<<<REQUIRED>>>

# First-time admin setup key (used once at /setup)
# Generate: openssl rand -hex 24
# #3279: FILL THIS ONE IN BEFORE THE BOX LISTENS. The marker below is not a gap, it is a
# value: app/api/setup/create-admin/route.ts:52-57 compares the supplied key against
# process.env.SETUP_KEY with plain !==, so a production box started straight from this
# template accepts the literal string `<<<REQUIRED>>>` as the bootstrap key for the first
# platform super admin — and this file is published in a public repo. compose only checks
# that the name is non-empty (${SETUP_KEY:?...}), so it cannot tell either. Deploy
# deploy/generate-secrets.sh output, and `npm run prod:preflight` now refuses an unfilled
# template token in any credential, this one included.
SETUP_KEY=<<<REQUIRED>>>

# Cron job authentication header
# Generate: openssl rand -hex 48
CRON_SECRET=<<<REQUIRED>>>
# Optional cron hardening (#1165, and #3298 which widened it to every /api/cron/*
# route): comma/space separated IPs or CIDRs allowed to call them. Empty = any address
# that presents CRON_SECRET. #3279: agrees with `.env.example` (both empty) — and both
# are only empty-and-harmless, because a value here WITHOUT TRUST_PROXY=true denies
# every call: the source address resolves to 'unknown' and unknown is on no list. The
# dashboard-triggered backup also re-enters /api/cron/backup over loopback with no
# forwarding header (app/api/tenant/backup/route.ts), so an allowlist must include the
# app's own egress address or that path 401s. compose does not forward this name, so on
# the Docker path it does nothing until the service environment carries it.
CRON_ALLOWED_IPS=

# Field-level encryption (API keys, SSO secrets, AI provider keys)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=<<<REQUIRED>>>

# Emergency recovery (last resort when all auth is broken)
# Generate: openssl rand -hex 32
EMERGENCY_RECOVERY_KEY=<<<REQUIRED>>>

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 3: DATABASE (PostgreSQL 16)                                     ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Connection string (Docker internal network).
# NOTE: keep this consistent with DATABASE_SSL below. If PostgreSQL is
# configured for TLS (recommended — see deploy/POSTGRES_PRODUCTION_GUIDE.md),
# use sslmode=require (or verify-full with a CA). Only use sslmode=disable if
# the DB is reachable *only* over the private Docker network AND you have set
# DATABASE_SSL=false. Do not leave sslmode=disable while DATABASE_SSL=true.
DATABASE_URL=postgresql://nucrm:<<<POSTGRES_PASSWORD>>>@postgres:5432/nucrm?sslmode=require

# External access (for tools like pgAdmin, DBeaver)
POSTGRES_USER=nucrm
POSTGRES_PASSWORD=<<<REQUIRED>>>
POSTGRES_DB=nucrm

# Pool tuning for 8GB VM (20 connections for app + 5 for worker + 5 for monitoring)
DATABASE_POOL_SIZE=20
# #3279: agrees with `.env.example` — both `true`, which is the point: #3279 listed this
# as unset in the dev template and it never was. Keep it consistent with the `sslmode`
# in DATABASE_URL above; the compose stack does NOT forward this name into the
# container, so on the Docker path the pool's own default applies.
DATABASE_SSL=true
DATABASE_STATEMENT_TIMEOUT=10000
# Escape hatch for cert VERIFICATION, for a database presenting a self-signed or
# otherwise untrusted certificate (lib/db/ssl-config.ts:26). Empty = verify. It has a
# second effect worth knowing: `false` also strips `sslmode=` from the connection string
# before libpq sees it (lib/db/pool.ts:174). Verification is only ON when NODE_ENV is
# 'production' (lib/db/ssl-config.ts:38), which is why the host path's missing NODE_ENV
# costs more than a cookie flag — it silently disables data-tier verification too.
# #3279: ecosystem.config.cjs pins this to 'false' for all three pm2 apps, a third
# source for one decision; set it here deliberately and they will not disagree quietly.
DATABASE_SSL_REJECT_UNAUTHORIZED=
# Whether DATABASE_URL points at a pooler. `false` matches the URL above, which names
# `postgres:5432` directly; the stack does run a pgbouncer service, but it is published
# on 127.0.0.1:6432 and the app is not wired to it. #3279: `.env.example` says `true`
# for the same reason this file says `false` — that template documents the developer's
# own box, and a laptop pointing straight at Postgres is the `false` case too, so check
# which one your DATABASE_URL is before copying either. Repoint DATABASE_URL at the
# pooler and you must set this `true` AND add the name to the compose service's
# environment, because compose does not forward it. Under TRANSACTION pooling the
# per-session `app.*` RLS GUCs leak between tenants, so the pooler must be in SESSION
# mode (lib/db/pool.ts).
PGBOUNCER_ENABLED=false

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 4: REDIS                                                        ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

REDIS_URL=redis://redis:6379
REDIS_MAXMEMORY=512mb

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 5: OBJECT STORAGE (S3 / MinIO)                                  ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# For MinIO (self-hosted S3-compatible, included in docker-compose)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=<<<REQUIRED>>>
AWS_SECRET_ACCESS_KEY=<<<REQUIRED>>>

# Buckets (auto-created by MinIO init)
BACKUP_BUCKET=nucrm-backups
DOCUMENT_BUCKET=nucrm-documents
BACKUP_KEEP_DAYS=30
DOCUMENT_MAX_BYTES=104857600

# Full-cluster pg_dump backups (deploy/scripts/backup.sh). Durable dir that
# survives reboots (NOT /tmp). Keep this many local .dump files before pruning.
BACKUP_DIR=/var/backups/nucrm
BACKUP_KEEP_LOCAL=7

# Public URL for presigned downloads (external access to MinIO)
S3_PUBLIC_URL=https://s3.yourdomain.com

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 6: EMAIL SERVICE                                                ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Option A: Resend (recommended for production)
RESEND_API_KEY=<<<REQUIRED>>>
RESEND_WEBHOOK_SECRET=

# Option B: SMTP fallback (if Resend unavailable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# Email sender display
EMAIL_FROM_NAME=NuCRM
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# #3279: agrees with `.env.example` (both `false`), and it is the one flag here whose
# wrong value produces no error at all — with `true`, lib/email/mock-service.ts accepts
# every send while the UI reports it delivered, so password resets, invites and limit
# warnings quietly stop leaving the box. `prod:preflight` fails a production process
# that has it on. compose does not forward this name, so the dev-template default is
# what the container gets unless you add it to the service environment.
RESEND_TEST_MODE=false

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 7: AI / LLM PROVIDERS                                           ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# The app supports multi-provider via the AI gateway.
# Configure at least ONE. Keys stored encrypted via ENCRYPTION_KEY.
# These are fallback defaults; tenants configure their own via UI.

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=<<<REQUIRED>>>

# Groq (fast inference)
GROQ_API_KEY=

# Ollama (self-hosted, optional)
OLLAMA_BASE_URL=

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 8: ERROR TRACKING — SENTRY                                      ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Get from: https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=<<<REQUIRED>>>
NEXT_PUBLIC_SENTRY_DSN=<<<REQUIRED>>>

# Organization + Project slug (for source map uploads)
SENTRY_ORG=<<<REQUIRED>>>
SENTRY_PROJECT=<<<REQUIRED>>>

# Auth token for CI/build source map upload
# Create at: https://sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=<<<REQUIRED>>>

# Runtime controls
SENTRY_ENABLE=true
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 9: MONITORING — GRAFANA + PROMETHEUS                            ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

GRAFANA_ADMIN_USER=<<<REQUIRED - change from 'admin'>>>  # Default is 'admin' — change for security
GRAFANA_ADMIN_PASSWORD=<<<REQUIRED>>>
GRAFANA_SERVER_ROOT_URL=https://grafana.yourdomain.com

# Prometheus (internal, no auth needed on Docker network)
PROMETHEUS_ENABLED=true

# Bearer token Prometheus presents when scraping the app's /api/metrics.
# /api/metrics fails closed in production without this. MUST match the value
# Prometheus mounts (docker-compose.production.yml writes it to a token file).
# Generate: openssl rand -hex 32
METRICS_SECRET=<<<REQUIRED>>>

# Postgres SSL mode for the postgres-exporter connection. Postgres on the host
# has ssl=on (see deploy/postgres/postgresql.conf), so 'require' is correct.
# Set to 'disable' ONLY if the host DB has no TLS configured.
POSTGRES_EXPORTER_SSLMODE=require

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 10: BILLING — STRIPE                                            ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 11: MESSAGING INTEGRATIONS (optional)                           ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Telegram Bot (for admin notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Twilio (SMS/Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Slack/Discord webhooks (for ops alerts)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# PagerDuty (incident management)
# Get integration key from PagerDuty → Services → Integrations → Events API v2
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_ENABLED=

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 12: FEATURE FLAGS & LIMITS                                      ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Usage limit enforcement (off = record only, on = block at limit + 402)
# #3279: `.env.example` leaves this empty and that is deliberate — a limit that trips
# during local work reads like a data bug, not a config one. It is still the difference
# between a plan limit existing and not existing, so the two files are NOT describing the
# same deployment: on here, off there. Only the exact string "on" blocks; "true" counts
# usage and enforces nothing (lib/usage/middleware.ts:26).
USAGE_LIMITS=on

# Module auto-install on signup (on = plan-based, off = legacy 3 modules)
MODULE_AUTO_INSTALL=on

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 13: INFRASTRUCTURE TUNING (8GB VM)                              ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Docker resource allocation
NUCRM_WEB_REPLICAS=2
NUCRM_WEB_MEMORY_LIMIT=768M
NUCRM_WEB_CPU_LIMIT=1.5
NUCRM_WORKER_REPLICAS=1
NUCRM_WORKER_MEMORY_LIMIT=512M
NUCRM_WORKER_CPU_LIMIT=0.5
NUCRM_PUBLIC_PORT=80
NUCRM_PUBLIC_SSL_PORT=443

# MinIO resource limits
MINIO_MEMORY_LIMIT=512M
