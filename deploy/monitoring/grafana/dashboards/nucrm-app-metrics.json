{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Tenants",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "expr": "nucrm_tenants_total", "legendFormat": "Total", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "title": "CRM row counts",
      "type": "stat",
      "description": "#3195: this scrape exports no tenant-keyed CRM totals. Under 0039 a table guarded by tenant_isolation reads as zero whenever app.current_tenant is unset, and a metrics scrape has no tenant to set — so the fifteen gauges were retired rather than left reporting a permanent zero. 0 = withheld (alert: CrmRowCountsWithheld); the numbers come back with the aggregate read-only privilege #3102 decides.",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "targets": [
        { "expr": "nucrm_crm_counts_exported", "legendFormat": "exported", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "nucrm_uptime_seconds",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },

    {
      "title": "Heap Usage",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 5 },
      "targets": [
        {
          "expr": "nucrm_memory_heap_used_bytes / nucrm_memory_heap_total_bytes * 100",
          "legendFormat": "Heap %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "title": "RSS Memory",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "nucrm_memory_rss_bytes",
          "legendFormat": "RSS",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },

    {
      "title": "Cache Status",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 5 },
      "targets": [
        { "expr": "nucrm_cache_up", "legendFormat": "Cache", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      }
    },

    {
      "title": "DB Active Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "nucrm_db_active_connections",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "nucrm_db_max_connections",
          "legendFormat": "Max",
          "refId": "B"
        },
        {
          "expr": "nucrm_db_pool_available",
          "legendFormat": "Available",
          "refId": "C"
        },
        {
          "expr": "nucrm_db_waiting_queries",
          "legendFormat": "Waiting",
          "refId": "D"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },

    {
      "title": "DB Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "targets": [
        {
          "expr": "nucrm_db_latency_ms",
          "legendFormat": "Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "title": "DB Active Queries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "targets": [
        {
          "expr": "nucrm_db_active_queries",
          "legendFormat": "Queries",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ],
  "schemaVersion": 39,
  "tags": ["nucrm", "app"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "NuCRM App Metrics",
  "uid": "nucrm-app-metrics",
  "version": 1
}
