{
  "name": "nucrm-enterprise",
  "version": "0.4.0",
  "description": "Multi-tenant Enterprise CRM built with Next.js 16, PostgreSQL, and JWT auth",
  "author": "abetworks.in",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://github.com/vinayakss007/nucrm-bigplan-by-vm-enterprise-v2#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinayakss007/nucrm-bigplan-by-vm-enterprise-v2.git"
  },
  "bugs": {
    "url": "https://github.com/vinayakss007/nucrm-bigplan-by-vm-enterprise-v2/issues"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.4.2",
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "sideEffects": false,
  "keywords": [
    "crm",
    "saas",
    "multi-tenant",
    "nextjs",
    "postgresql",
    "typescript",
    "customer-relationship-management",
    "lead-management",
    "sales-pipeline"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:nosync": "next dev",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:up:dev": "MODE=dev bash scripts/dev-up.sh",
    "prebuild": "node scripts/check-build-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "guard:rls": "node scripts/check-rls-route-coverage.mjs",
    "guard:schemas": "node scripts/check-schema-drift.mjs",
    "guard:boundaries": "node scripts/check-route-boundaries.mjs",
    "typecheck": "npx tsc --noEmit --pretty",
    "check": "npm run typecheck && npm run lint && npm run test:unit && echo '✅ All checks passed'",
    "premerge": "bash scripts/pre-merge-check.sh",
    "smoke": "bash scripts/smoke-test.sh",
    "launch-gate": "bash scripts/launch-gate.sh",
    "up": "bash scripts/bootstrap.sh",
    "start-clean": "bash scripts/start-clean.sh",
    "db:generate": "npx tsx scripts/generate-migration.ts",
    "db:migrate": "npx tsx scripts/migrate.ts",
    "db:rollback": "npx tsx scripts/rollback-migration.ts",
    "db:rollback:coverage": "npx tsx scripts/rollback-migration.ts --coverage",
    "db:status": "npx tsx scripts/migration-status.ts",
    "db:auto": "npx tsx scripts/migrate.ts",
    "db:sync": "if [ \"$CI\" != \"true\" ]; then echo '⚠️  db:sync is dangerous — use db:migrate instead'; exit 1; fi && npx drizzle-kit push --config=./drizzle.config.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "seed:e2e": "tsx scripts/seed-e2e-user.ts",
    "db:seed": "npx tsx scripts/seed-dev.ts",
    "db:demo": "npx tsx scripts/seed-dev.ts",
    "db:studio": "node -e \"console.log('Use DBeaver or pgAdmin to connect: ' + process.env.DATABASE_URL)\"",
    "db:drop": "npx tsx scripts/drop-all.ts",
    "db:verify-isolation": "npx tsx scripts/verify-tenant-isolation.ts",
    "db:verify-integrity": "npx tsx scripts/verify-data-integrity.ts",
    "db:diagnose": "npx tsx scripts/diagnose-production.ts",
    "db:verify-chain": "npx tsx scripts/verify-migration-chain.ts",
    "db:drift-check": "npx tsx scripts/drift-check.ts",
    "backup:verify": "npx tsx scripts/verify-backup.ts",
    "backup:restore": "npx tsx scripts/restore-db.ts",
    "preflight": "npx tsx scripts/preflight.ts",
    "infra:check": "bash deploy/scripts/infra-readiness.sh",
    "dr": "npx tsx scripts/dr.ts",
    "db:restore": "npx tsx scripts/restore-db.ts",
    "db:reset": "npx tsx scripts/drop-all.ts && npm run db:migrate",
    "setup": "cp -n .env.example .env.local && npm run db:migrate && echo '\n✅ Run: npm run dev\n'",
    "prod:launch": "bash scripts/production-launch.sh",
    "prod:preflight": "npx tsx scripts/diagnose-production.ts",
    "prod:start": "bash scripts/start-production.sh",
    "prod:start:custom": "node --max-old-space-size=2048 node_modules/next/dist/bin/next start -H 127.0.0.1",
    "prod:seed": "npx tsx scripts/seed-fresh.ts",
    "telegram:setup-webhook": "npx tsx scripts/telegram-setup-webhook.ts",
    "demo:setup": "npx tsx scripts/seed-dev.ts",
    "worker": "tsx worker.ts",
    "realtime": "tsx realtime.ts",
    "worker:dev": "tsx watch worker.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker:dev\" -c \"blue,bold.yellow\" -n \"APP,WORKER\"",
    "start:app": "next start",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/dashboard",
    "test:billing": "tsx scripts/billing-lifecycle-test.ts",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage tests/unit",
    "test:ui": "vitest --ui",
    "logs:watch": "tail -f nucrm.log",
    "logs:errors": "tail -f nucrm.log | grep -i --line-buffered error",
    "logs:view": "echo '📡 Opening log viewer... && open log-viewer.html || xdg-open log-viewer.html'",
    "analyze:bundle": "ANALYZE=true npm run build && npx tsx scripts/analyze-bundle.ts",
    "analyze:visual": "ANALYZE=true npm run build",
    "quality:report": "npx tsx scripts/quality-report.ts",
    "quality:lint": "npx eslint . --max-warnings 46",
    "quality:full": "npm run typecheck && npm run quality:lint && npm run test && npm run quality:report",
    "lighthouse:audit": "npx tsx scripts/lighthouse-audit.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@node-saml/node-saml": "^5.1.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@sentry/nextjs": "^10.71.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@xyflow/react": "^12.11.5",
    "autoprefixer": "10.5.4",
    "bcryptjs": "3.0.3",
    "bullmq": "5.77.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "ioredis": "5.10.1",
    "jose": "6.2.10",
    "lucide-react": "1.34.0",
    "mathjs": "^15.2.0",
    "next": "16.3.3",
    "next-themes": "0.4.6",
    "nodemailer": "^9.0.6",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "pg-boss": "12.28.0",
    "postcss": "8.5.26",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "2.6.0",
    "react-markdown": "^10.1.0",
    "recharts": "2.15.4",
    "remark-gfm": "^4.0.1",
    "resend": "4.8.0",
    "swr": "^2.5.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.12",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.3",
    "@playwright/mcp": "^0.0.79",
    "@playwright/test": "^1.62.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/bcryptjs": "3.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "9.2.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "26.1.0",
    "lighthouse": "^13.4.1",
    "lint-staged": "^15.5.2",
    "playwright": "^1.62.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "ws": "^8.21.0",
    "brace-expansion": "^2.1.4",
    "fast-uri": "^3.1.6",
    "js-yaml": "^4.3.2",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.6"
  }
}
