# NuCRM Environment Variables
# Copy this file to .env.local and fill in your values

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DEV QUICK START
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. Copy this file: cp .env.example .env.local
# 2. Set DATABASE_URL to your local PostgreSQL:
#      DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nucrm
# 3. Run migrations: npm run db:migrate
# 4. Seed dev data: SEED_PASSWORD must be set to your own password first (#3281).
#    npm run seed:dev refuses to run without one, and the value is never echoed.
# 5. Start the app: npm run dev
#
# Notes:
# - SENTRY_DSN is optional for local development
# - Sentry initializes whenever a DSN is set; set SENTRY_DISABLE=true to turn it off
# - Most third-party keys (Resend, Twilio, etc.) are not needed for local dev
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PRODUCTION HOST PATH (pm2 / `next start` behind nginx) — #3279
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Everything in this file is the DEV answer. `deploy/.env.production` is the
# Docker/compose answer, and the two deliberately differ on four variables —
# each divergence is marked #3279 at the variable itself. If you are bringing up
# a host install from THIS file, those four must change together, and
# deploy/LAUNCH_RUNBOOK.md §2 step 3 lists the same set:
#   use NODE_ENV=production — cookie-Secure forcing, ALLOW_DEMO_MODE gating and
#     the SETUP_KEY gate all key off this; unset ships a
#     production box that behaves like a laptop
#   use TRUST_PROXY=true — behind nginx ONLY; see the #3279 note at the variable
#   use COOKIE_SECURE=true — see the #3279 note in the cookie section
#   keep DATABASE_SSL=true — already this file's default, and the compose
#     template's; change it only if the data tier has no TLS
# Then prove it on the process, not on the file:
#   npm run prod:preflight    (runs scripts/assert-runtime-env.mjs --expect-production)
# which reads the environment the server actually has, because a value that is
# right on disk and absent from the worker still changes behaviour (#3271: pm2
# replays the env it captured at first `start`, so `pm2 reload
# ecosystem.config.cjs --update-env` is what pushes a change into live workers).
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# The password scripts/seed-dev.ts writes for the seeded super admin (#3281).
# There is no default: the repository used to commit 'password123' into the seed,
# which is a login to the platform bypass role in a public repo. Set this to a
# password you own — it must satisfy the app's own policy (lib/auth/session.ts:38-46):
# at least 12 characters, with an uppercase letter, a digit and one of !@#$%^&*(),.?":{}|<>.
# Generate one: node -e "console.log(require('crypto').randomBytes(12).toString('base64url')+'!A7')"
SEED_PASSWORD=

# The two destructive scripts (#3282) refuse to run without an explicit opt-in, because
# `npm run prod:seed` used to be a name that meant "wipe the identity layer and plant an
# admin with the published password `Admin123!`", and `npm run db:drop` / `db:reset` drop
# `public` with CASCADE. Both now print the resolved host:port/dbname first and stop.
# Ask what is in the target before you reach for either:  npm run db:state
# The renamed provisioning command (it provisions a database that is EMPTY):
#   npm run db:seed:from-empty
# Set one of these to 1 only when you mean that particular database and have a backup.
# Leaving them unset does not disable anything — it just means a human has to type the
# database name, or pass --yes.
NUCRM_ALLOW_PROD_SEED=
NUCRM_ALLOW_DROP=

# Database (PostgreSQL)
# Local dev example: postgresql://postgres:postgres@localhost:5432/nucrm
DATABASE_URL=postgresql://user:password@host:5432/nucrm
DATABASE_SSL=true
# Pool size MUST cover concurrent in-flight API requests: each request pins one
# client for its whole lifetime (#1615). A dashboard mount alone fans out to
# 10-15 endpoints; 5 is too tight for a WAN/cloud Postgres (#1972). Default 20.
DATABASE_POOL_SIZE=20
# Pool checkout deadline (#2122): requests waiting longer than this get an
# immediate 503 + Retry-After instead of queueing toward a doomed 30s wait.
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Backup dump role (PP-014/PP-015, #2050/#2051) — used by backup scripts only,
# never by the app. pg_dump runs `SET row_security = off`, which PostgreSQL
# honours only for superuser/BYPASSRLS roles, and every tenant table is FORCE
# ROW LEVEL SECURITY — so the RLS-bound app role cannot produce a dump.
# Point this at a BYPASSRLS role; do NOT disable FORCE RLS as a workaround.
BACKUP_DATABASE_URL=

# Authentication — NEVER use weak/dev secrets in any environment
# Generate with: openssl rand -base64 64
JWT_SECRET=
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Generate with: openssl rand -hex 32
# #3279: REQUIRED for a production deploy — README.md's variable table marks it
# "Yes". Empty here is fail-CLOSED (/api/setup/create-admin answers 403), and that is
# why this template leaves it empty rather than carrying a fill-me token:
# deploy/.env.production writes SETUP_KEY=<<<REQUIRED>>>, and
# app/api/setup/create-admin/route.ts:52-57 compares the supplied key against
# process.env.SETUP_KEY with plain !==, so a production box shipped straight from that
# template accepts the string in a public repo as the bootstrap key for the first
# platform super admin. `npm run prod:preflight` fails on that value now.
SETUP_KEY=
# Generate with: openssl rand -base64 64
CRON_SECRET=
# Optional cron hardening (#1165) — leave unset to keep the plain-secret behaviour.
# Comma/space separated IPs or CIDRs allowed to call /api/cron/* (requires TRUST_PROXY=true).
# Example (GCP Cloud Scheduler): CRON_ALLOWED_IPS=35.191.0.0/16,130.211.0.0/22
# #3298: this now binds every /api/cron/* endpoint (all 22), not the two that happened
# to call the shared check. Two consequences before you set it: without TRUST_PROXY=true
# the source address is unknown and unknown is denied, so the scheduler stops; and the
# dashboard-triggered backup re-enters /api/cron/backup over loopback with no forwarding
# header (app/api/tenant/backup/route.ts), so an allowlist has to include the app's own
# egress address or that path 401s.
CRON_ALLOWED_IPS=
# When set, cron callers must also send x-cron-signature: sha256=<hmac of raw body>.
# Do NOT set this yet (#3298): no route passes its raw body down to the check, so the
# HMAC is computed over the empty string and a correctly signed caller is denied. It is
# an off switch until the routes read their body once and hand the bytes down.
CRON_SIGNING_KEY=

# Application
# #3279: differs from deploy/.env.production ON PURPOSE — this file is the dev
# template and that one is the compose template. A production deploy needs the public
# https origin here; `next build` inlines NEXT_PUBLIC_* into every client bundle, so a
# localhost value baked into a production build also breaks OAuth redirects and every
# server-generated link (#1040). Asserted against the live process by
# `npm run prod:preflight`.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# #3279: same reason, same divergence. Whatever is listed here is what the CORS check
# admits, so a production allowlist must name the real origin and nothing else; leaving
# the dev value in place on a deploy means a cleartext loopback origin is allowed.
ALLOWED_ORIGINS=http://localhost:3000
# #3279: unset or `development` here is the dev default; a production host MUST set
# `production`, and this is the variable deploy-vm.sh never sets at all. It is not
# cosmetic: cookie-Secure forcing (#2275), ALLOW_DEMO_MODE gating
# (lib/auth/middleware.ts:62) and the SETUP_KEY gate on /api/setup/create-admin all
# branch on it, so a live box with NODE_ENV missing serves production traffic with dev
# security behaviour. Set it in the environment that builds the process env (pm2's
# ecosystem block already does), not only in the file.
NODE_ENV=development
# Set to true ONLY when running behind a trusted reverse proxy (nginx, Vercel, etc.)
# that overwrites X-Forwarded-For. When true, client IPs are read from proxy headers
# for rate limiting. When false (direct exposure), headers are ignored and all
# clients share the 'unknown' rate-limit bucket — never enable direct-to-internet
# with this on.
# #3279: `false` is right for a laptop and wrong for a deploy, and this is the one
# variable in this file that cost real debugging hours. getClientIp()
# (lib/client-ip.ts:15) returns 'unknown' unless this is exactly the string 'true', and
# checkRateLimit (lib/rate-limit.ts:442, #2630) then fails CLOSED with 503 for every
# auth-scoped action — so a host install copied from this file serves the app, and
# nobody can log in, and the error message blames the caller. deploy/.env.production
# says 'true' because that stack sits behind nginx (docker-compose.production.yml pins
# it in the container env too); this file stays 'false' because turning it on where a
# client can reach the port directly lets every caller pick its own rate-limit bucket
# by sending X-Forwarded-For. For a production host path, set it true — and then verify
# it reached the process, not the file: `npm run prod:preflight` (#3271: pm2 replays the
# env captured at first `start`, so `pm2 reload ecosystem.config.cjs --update-env` is
# what applies a change to live workers, and ecosystem.config.cjs — the file that
# builds the pm2 worker's environment — does not name TRUST_PROXY at all, so nothing on
# the host path sets it for you).
TRUST_PROXY=false

# Redis
REDIS_URL=redis://host:6379

# Email — REQUIRED for password resets, invites & notifications (#1041).
# Configure Resend (preferred) OR SMTP. With neither set, email will NOT send;
# in production this is logged as an error and shown as 'degraded' in
# /api/system/health.
#   Resend: sign up at resend.com, verify your sending domain, paste the key.
RESEND_API_KEY=re_xxxxxx
SMTP_FROM_NAME=NuCRM
SMTP_FROM_EMAIL=noreply@yourdomain.com
#   SMTP fallback (used only if RESEND_API_KEY is unset):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=


# WhatsApp (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Voice (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Storage (S3/R2)
#
# Credentials are resolved in this order, first non-empty wins:
#   access key : S3_ACCESS_KEY_ID | S3_ACCESS_KEY | AWS_ACCESS_KEY_ID
#   secret key : S3_SECRET_ACCESS_KEY | S3_SECRET_KEY | AWS_SECRET_ACCESS_KEY
# docker-compose.yml exports the S3_ACCESS_KEY / S3_SECRET_KEY pair.
#
# All three of a bucket + access key + secret key must be present. If any is
# missing, off-site storage is treated as unconfigured and database backups stay
# on the application host only, which does NOT survive a container restart.
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# Bucket for uploaded files. Also used for backups when BACKUP_BUCKET is unset.
S3_BUCKET=nucrm-files
# Optional dedicated bucket for database backups.
BACKUP_BUCKET=nucrm-backups

# Defaults to "auto" when S3_ENDPOINT points at R2, otherwise us-east-1.
S3_REGION=auto
# For Cloudflare R2:
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# Backup settings
# Retention window for backup objects. BACKUP_RETENTION_DAYS is canonical;
# BACKUP_KEEP_DAYS is accepted as an alias. Must be a positive integer.
#
# FLOOR (#2233 follow-up): an automated job may never delete a backup younger
# than MIN_RETENTION_DAYS (730 days / 2 years), so any value below that is
# clamped up to it and a warning is logged. Shortening the window is not a
# config option here — deleting critical data is a deliberate act.
BACKUP_RETENTION_DAYS=730

# Where deploy restore points and local dumps are written.
#
# Local copies are NEVER deleted by any automated path in this repo (#2233
# follow-up): scripts/backup-db.ts creates and uploads only, and
# scripts/deploy-migrate.ts writes restore points and has no code path that
# unlinks anything. Pruning local disk is a human decision.
#
# Put this on durable storage. The /tmp default is erased by a reboot, and a
# restore point that a reboot erases is not a restore point — deploy-migrate
# therefore refuses to run with an ephemeral BACKUP_LOCAL_DIR unless
# DEPLOY_ALLOW_EPHEMERAL_RESTORE_POINT=1 says you mean it.
BACKUP_LOCAL_DIR=/srv/nucrm/backups
# DEPLOY_ALLOW_EPHEMERAL_RESTORE_POINT=1

# ── Sentry (Error Tracking) ────────────────────────────
# Get your DSN from: https://sentry.io
# Sentry initializes whenever SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN is set,
# regardless of environment. Set SENTRY_DISABLE=true to explicitly turn it off.
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=nucrm
SENTRY_PROJECT=nucrm-app
SENTRY_AUTH_TOKEN=
# Set to true to disable Sentry entirely
SENTRY_DISABLE=false
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Telegram Bot Webhook (Interactive Bot) ─────────────
# After deploying, register the webhook:
#   npm run telegram:setup-webhook
# Or manually:
#   curl -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/setWebhook" \
#     -H "Content-Type: application/json" \
#     -d '{"url": "https://yourdomain.com/api/webhooks/telegram/bot"}'
# Then message your bot on Telegram with /start

# ── Critical Error Alerts ──────────────────────────────
# When set, fatal errors will POST to this URL with message, stack trace, timestamp, and environment
# Rate-limited to 1 alert per 60 seconds per error type (message prefix)
CRITICAL_ERROR_WEBHOOK_URL=https://hooks.example.com/critical-errors

# ── PagerDuty (Incident Management) ────────────────────
# Get from PagerDuty → Services → your service → Integrations → Events API v2
# PAGERDUTY_ROUTING_KEY is a 32-char hex integration key
# PAGERDUTY_ENABLED=true/false (auto-detected from routing key if omitted)
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_ENABLED=

# ── Grafana (Monitoring) ───────────────────────────────
GRAFANA_ADMIN_USER=admin  # Change this in production
GRAFANA_ADMIN_PASSWORD=generate-a-random-password-here

# ── Stripe (Billing) ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxx

# ── Encryption (Backup Security) ───────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Webhook Secrets ────────────────────────────────────
RESEND_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=

# ── Read replica (optional) ──────────────────────────────────────────────────
# When set, heavy read queries (reports, search, analytics, export) are routed
# to this connection instead of the primary. Reduces primary load.
# When absent, all reads use the primary (no change to current behavior).
DATABASE_READ_REPLICA_URL=
DATABASE_READ_POOL_SIZE=10
DATABASE_READ_STATEMENT_TIMEOUT=30000

# ── Backup encryption ────────────────────────────────────────────────────────
# AES-256-GCM encryption key for backup artefacts. When set, pg_dump output is
# encrypted before upload to S3. When absent, backups are stored unencrypted
# (backward-compatible). Use at least 32 random characters in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
# Previous key, kept only while rotating. Decryption tries BACKUP_ENCRYPTION_KEY
# first and falls back to this, so artefacts sealed before the rotation stay
# restorable. New backups always use the current key. Remove this once no
# retained backup predates the rotation.
BACKUP_ENCRYPTION_KEY_PREV=
# ── Public marketing site ────────────────────────────────────────────────
# Canonical origin, used for canonical URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://nucrm.abetworks.in
# Workspace that enquiries from /contact are filed into as leads. Without it
# the contact page shows a mailto fallback instead of the form, rather than
# rendering a form that would fail on submit.
NEXT_PUBLIC_MARKETING_TENANT_ID=

# ── Beta bug-report button (top-bar 🐛) ──────────────────────────────────
# Reports are forwarded straight out — nothing is stored in the app database.
# Preferred: file GitHub issues into the repo you already triage from.
# Create a fine-grained PAT with "Issues: write" on just this repo.
GITHUB_ISSUES_TOKEN=
GITHUB_ISSUES_REPO=vinayakss007/nucrm-bigplan-by-vm-enterprise-v2
# Or any webhook — Discord and Slack URLs are formatted natively; everything
# else receives structured JSON. Optional bearer token for non-GitHub sinks:
BUG_REPORT_ENDPOINT=
BUG_REPORT_ENDPOINT_TOKEN=

# ── Cookie `Secure` attribute (#2275) ────────────────────────────────────
# Applies to every auth cookie (nucrm_session, nucrm_csrf_token, impersonation,
# SSO state, portal session, analytics anon-id). Resolution order:
#   1. COOKIE_SECURE ("true"/"false") — ALWAYS wins, in every environment.
#   2. Unset + production build → Secure is forced (fail-closed), even when a
#      reverse proxy presents the request as http. Serve HTTPS, or set
#      COOKIE_SECURE=false only if you knowingly run cleartext HTTP.
#   3. Unset + dev/test build → Secure only when the request arrived over
#      HTTPS; plain http://localhost sign-in keeps working.
# #3279: left commented here because rule 2 already covers a production BUILD, which
# is what an operator who forgets this variable gets. deploy/.env.production assigns it
# `true` explicitly instead, because the compose path may present a TLS-terminated
# request as http to the container. Being unset is safe; being explicitly `false` on a
# deploy is not, and that is the one value prod:preflight refuses.
# COOKIE_SECURE=

# ══════════════════════════════════════════════════════════════════════════
# Everything below was added by #2596: names the code actually reads but that
# were missing from this file. Each group is ordered as the code reads it, and
# every entry states the value used when the variable is UNSET, because that
# default is what you are running today whether or not you knew it.
# Enforced by `npm run guard:env-coverage` (scripts/check-env-coverage.mjs).
# ══════════════════════════════════════════════════════════════════════════

# ── Database pool tuning ────────────────────────────────────────────────────
# Per-query ceiling in milliseconds (lib/db/pool.ts:200). A report or export
# that runs longer is cancelled by Postgres, not left to accumulate. Raise it
# only if a legitimately long job is being killed.
DATABASE_STATEMENT_TIMEOUT=10000
# With PGBOUNCER_ENABLED=true the pooler terminates TLS, so an sslmode in the
# connection string is stripped before libpq sees it. Set this to false to stop
# that stripping if you connect to Postgres directly (lib/db/pool.ts:174).
DATABASE_SSL_REJECT_UNAUTHORIZED=
# MUST be true when DATABASE_URL points at PgBouncer in TRANSACTION pooling
# mode; NuCRM runs session pooling, where prepared statements and the per-
# session `SET app.*` RLS GUCs are safe. Under transaction pooling the RLS
# context would leak between tenants. (lib/db/pool.ts:41)
# #3279: `true` here because a `false` is what deploy/.env.production now says — that
# file's DATABASE_URL names the postgres service directly, so it is the no-pooler case,
# and a laptop following this file's own quick start (plain PostgreSQL on localhost) is
# the same case. The two values are not a decision that was made twice; they are two
# different topologies. Read the line as: `true` if and only if DATABASE_URL actually
# resolves to a pooler, since the flag appends `pgbouncer=true` to the connection string
# (turning off prepared statements) and drops the idle timeout to 10s (lib/db/pool.ts:153).
PGBOUNCER_ENABLED=true
# A connection held longer than this is reported as leaked (lib/db/leak-detector.ts:41).
DB_LEAK_THRESHOLD_MS=30000
# Queries slower than this are logged with their statement (lib/db/slow-query.ts:21).
SLOW_QUERY_THRESHOLD_MS=200
# Directory of one-file-per-secret credentials read at boot by lib/secrets-file.ts.
# Each file's name is upper-cased and '-'→'_' to become the variable it fills;
# only empty/unset variables are filled, so real env always wins.
# SECRETS_DIR=/run/secrets

# ── URLs, tenancy and auth ──────────────────────────────────────────────────
# Canonical origin for server-generated links (emails, OAuth redirects).
# Falls back to NEXT_PUBLIC_APP_URL, then http://localhost:3000
# (app/auth/login/actions.ts:14). Keep it identical to NEXT_PUBLIC_APP_URL.
APP_URL=
# Tenant an inbound Twilio SMS is attributed to when the message carries no
# tenant identifier (app/api/tenant/sms/webhook/route.ts:54). Unset = such
# messages are dropped rather than misfiled.
DEFAULT_TENANT_ID=
# Trial length granted to a new workspace created from the super-admin console
# (app/api/superadmin/settings/route.ts:69).
DEFAULT_TRIAL_DAYS=14
# Address that operational mail (limit warnings, digest) is sent to
# (lib/email/service.ts:339). Unset = those notifications are not sent.
SUPER_ADMIN_EMAIL=
# Cost factor for session token hashing (lib/auth/session.ts:51). 12 ≈ 250ms;
# lowering it weakens stored credentials, raising it costs every sign-in.
BCRYPT_ROUNDS=12
# When true, sign-in requires a verified address (lib/auth/api-handlers.ts:148).
# Leave false until every mail path really delivers, or users lock themselves out.
REQUIRE_EMAIL_VERIFY=false
# Enables the read-only demo tenant. Only honoured when NODE_ENV is not
# "production" (lib/auth/middleware.ts:62) — setting it on a live deploy does
# nothing, which is the point.
ALLOW_DEMO_MODE=false

# ── Auth surfaces, gates and escapes ────────────────────────────────────────
# Legacy name that lib/email/unsubscribe-token.ts:23 still accepts as a
# fallback for UNSUBSCRIBE_SECRET. Prefer setting UNSUBSCRIBE_SECRET; this
# fallback exists only so tokens minted before that split keep validating.
NEXTAUTH_SECRET=
# HMAC key for unsubscribe links (lib/email/unsubscribe-token.ts:23). Falls
# back to NEXTAUTH_SECRET; with neither set, unsubscribe links cannot be
# verified and one-click opt-out returns an error page.
UNSUBSCRIBE_SECRET=
# Last-resort account recovery credential (app/api/emergency/recover/route.ts:77).
# Ignored entirely unless at least 32 characters. Store it in a password
# manager, never in this file, and rotate after any use.
EMERGENCY_RECOVERY_KEY=
# Signing key for SCIM bearer tokens (lib/scim/index.ts:283). Unset = the whole
# SCIM endpoint is disabled rather than unprotected.
SCIM_SECRET=
# Accepts the retired v1 SCIM token format, which has no expiry and no
# per-tenant binding (lib/scim/index.ts:325). Set true only for a migration
# window and drop it as soon as the IdP is re-registered on v2.
SCIM_ALLOW_V1_TOKENS=false
# Bearer token required by GET /api/metrics (app/api/metrics/route.ts:60).
# The endpoint fails CLOSED: with no secret configured it answers 503 in every
# environment, so scrape targets must set this.
METRICS_SECRET=
# Set true to short-circuit metric collection itself (lib/metrics.ts:51) — use
# it when the metrics path is causing load, not to hide the endpoint.
METRICS_DISABLED=false
# Outbound webhook signing secret (lib/webhooks/delivery.ts:207). Signing happens
# BEFORE the request is attempted and throws if this is unset or left at the
# placeholder value, so with no secret configured no tenant receives anything at
# all — the failure is an exception, not a silent unsigned delivery.
WEBHOOK_SECRET=
# Secret tenants use to verify NuCRM docs webhooks
# (components/tenant/docs-client.tsx:2338). Same value must be given to them.
NUCRM_WEBHOOK_SECRET=
# Route CSRF validation through the central proxy check instead of per-handler
# calls (lib/auth/middleware.ts:220). Enable per #2579 before removing handler
# -level checks, not after.
CSRF_ENFORCE_CENTRAL=false
# When Redis is down, treat a failed lock acquisition as success
# (lib/cache/index.ts:316). Default fail-CLOSED is correct: callers take the
# stale/retry path instead of every replica running the fallback at once.
# Set true only for idempotent, separately-guarded callers.
LOCK_FAIL_OPEN=false
# Set to the exact string "on" to make plan-limit checks BLOCK requests
# (lib/usage/middleware.ts:26). Anything else — including "true" — only counts
# usage, which is the safe rollout position.
# #3279: deliberately empty here while deploy/.env.production ships `USAGE_LIMITS=on`.
# Record-only is the right default for a laptop — a limit that trips during local work
# looks like a data bug, not a config one — but on a deploy it means a tenant can
# overrun its plan and nothing refuses the request, so the value you copy determines
# whether the limit exists at all.
USAGE_LIMITS=
# Comma-separated hostnames exempt from SSRF screening
# (lib/security/ssrf.ts:230). For outbound fetches to internal services only;
# every entry is a way for a tenant-controlled URL to reach your network.
SSRF_ALLOWED_HOSTS=

# ── Files, exports and Redis ────────────────────────────────────────────────
# Upload ceiling per document, in bytes (app/api/tenant/documents/route.ts:25).
DOCUMENT_MAX_BYTES=104857600
# Row ceiling for a synchronous export (lib/export/index.ts:36). Above it the
# request is rejected with 413 and the user is told to page or narrow.
EXPORT_MAX_ROWS=50000
# Redis coordinates for the queue-depth check
# (app/api/system/worker-health/route.ts:47). REDIS_URL is used elsewhere;
# these two only override this route's probe target.
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Transactional email providers ───────────────────────────────────────────
# Router probes these in order (lib/email/router.ts:96-107); the first
# configured provider handles a send and the rest are fallbacks.
SENDGRID_API_KEY=
BREVO_API_KEY=
# Brevo's SMTP credentials. READ INTO THE PROVIDER RECORD AND NO FURTHER:
# lib/email/router.ts:97-100 stores them as smtpHost/smtpPort/smtpUser/smtpPass
# on the brevo entry, and nothing in lib/email/ consumes those four fields —
# real SMTP sending goes through SMTP_HOST/SMTP_USER/SMTP_PASS (see the SMTP
# section above) and Brevo's own path is the API key. Setting these four
# changes no behaviour; they are documented so the next reader does not assume
# a Brevo SMTP fallback exists, which is what #2126 and #2596 both took for
# granted.
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
# Forces the mock mailer even when RESEND_API_KEY is present
# (lib/email/mock-service.ts:41). Also implied by an absent API key. Never set
# true on a deploy that must actually deliver mail.
RESEND_TEST_MODE=false
# Operational alert sinks (lib/email/service.ts:367,391). Discord and Slack
# payloads are formatted natively; both are optional.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── Payments ────────────────────────────────────────────────────────────────
# Stripe Price IDs (not amounts) for plan checkout links
# (lib/stripe.ts:549-558). Unset plan = that plan cannot be purchased.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=
# Razorpay (lib/razorpay.ts:112-130). Key ID is also sent to the browser by
# app/api/tenant/billing/razorpay/route.ts:78 — it is public by design; the
# secret and webhook secret are not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# PayU (lib/payu.ts:25-33). "test" resolves against the sandbox; anything other
# than the exact string "test" is treated as live.
PAYU_MODE=test
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# ── AI, currency and integrations ───────────────────────────────────────────
# Fallback Anthropic key for tenants that have not set their own
# (app/api/tenant/ai/route.ts:113). Prefer per-tenant keys; this one is billed
# to the platform and shared by every tenant without a key.
ANTHROPIC_API_KEY=
# Cost assumed per AI request for usage accounting
# (app/api/tenant/ai/route.ts:148). Bookkeeping figure, not a price.
AI_ESTIMATED_COST_CENTS=50
# Key for the live FX endpoint (lib/currency.ts:80). "demo" is the default and
# serves static rates — set a real key before trusting a converted total.
EXCHANGE_RATE_API_KEY=demo
# Sender for outbound SMS (lib/sms.ts:82). SID/AUTH_TOKEN/PHONE_NUMBER are
# documented above; this overrides the displayed from-number.
TWILIO_FROM_NUMBER=
# Google Calendar OAuth app (lib/calendar-sync/google.ts). Redirect URI defaults
# to ${APP_URL}/api/tenant/calendar-sync/google/callback when unset.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
# Microsoft calendar equivalent (lib/calendar-sync/outlook.ts:189).
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_REDIRECT_URI=
# e-signature providers, both read by lib/esignature.ts. At least one pair is
# needed for the signing flow; DOCUSIGN_BASE_URL defaults to the DocuSign
# sandbox (https://demo.docusign.net/restapi), so a live account must set it.
DOCUSIGN_API_KEY=
DOCUSIGN_BASE_URL=
DOCUSIGN_WEBHOOK_SECRET=
HELLOSIGN_API_KEY=
HELLOSIGN_BASE_URL=https://api.hellosign.com/v3
HELLOSIGN_WEBHOOK_SECRET=

# ── Observability ───────────────────────────────────────────────────────────
# Gates forwarding of structured errors to Loki. The check is at
# lib/errors-server.ts:105, before the client is imported, so with this unset
# the whole path is a genuine no-op. It also gates a block at
# lib/dev-logger.ts:145 that contains comments and no statement — the errors
# path is the one that does something.
GRAFANA_ENABLED=false
# Loki endpoint and basic-auth pair (lib/grafana.ts:298-321). Without LOKI_URL
# log shipping is off regardless of GRAFANA_ENABLED.
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
# OTLP trace endpoint and its full "Key=...,Auth=..." header pair
# (lib/grafana.ts:45-48).
OTLP_ENDPOINT=
OTLP_HEADERS=
# Analytics backend (lib/analytics/store.ts:70): "postgres" (default) or one of
# "none"/"off"/"disabled" to stop recording events.
ANALYTICS_STORE=postgres
# Build-time switch that removes the browser analytics provider entirely
# (components/shared/analytics-provider.tsx:23). Must be set before the build;
# changing it at runtime does nothing.
NEXT_PUBLIC_ANALYTICS_DISABLED=false

# ── Backup paths (read by three different things — see below) ───────────────
# Directory the SUPER-ADMIN health check reports on
# (app/api/system/health/route.ts:143, default /tmp/backups) and the shell
# script scripts/backup-rls-live.sh (default /var/tmp/nucrm-backups) — the two
# defaults are NOT the same directory.
# The application's own backup jobs use BACKUP_LOCAL_DIR instead (default
# /tmp/nucrm-backups), and scripts/backup-db.sh hard-codes its path and ignores
# both. Set BACKUP_LOCAL_DIR to your durable volume, then set BACKUP_DIR to the
# same value so the health check is looking at what the app actually writes.
# Never point either at /tmp: a reboot erases the restore point.
BACKUP_DIR=
# S3 client region/endpoint for the restore route
# (app/api/superadmin/restore/route.ts:202-203). Falls back to the AWS SDK
# defaults; only needed for S3-compatible storage (MinIO, R2, Wasabi).
AWS_REGION=
AWS_ENDPOINT_URL=

# ── Telegram bot ────────────────────────────────────────────────────────────
# Same bot as the alert webhook documented above; these three drive the
# interactive command handler (app/api/webhooks/telegram/bot/route.ts:32-97).
# CHAT_ID is the admin chat that receives operator output; WEBHOOK_SECRET must
# match the secret passed to setWebhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── Operator-run scripts (set in the shell, not in the app runtime) ──────────
# These are read by scripts/*.ts and scripts/*.mjs when you invoke them
# yourself; the app never sees them. Defaults shown are what the script does
# with no value set.
#   restore-db.ts         target of a restore; REQUIRED, no default.
# TARGET_DATABASE_URL=postgresql://…
#   migration-status.ts   connection used to read the migration ledger;
#                         defaults to DATABASE_URL.
# PROBE_DATABASE_URL=
#   provision-app-role.mjs password / role name for the dedicated app role it
#                         creates; OWNER_ROLE defaults to "postgres" and is the
#                         account that must run the script.
# NUCRM_APP_PASSWORD=
# OWNER_ROLE=postgres

# ── Realtime server (realtime.ts, the socket.io process) ────────────────────
# Interface the websocket server binds to (realtime.ts:63). Default 127.0.0.1
# keeps the port off the VM's public interface, which is correct for the VM
# where nginx proxies /socket.io/ to it. Docker compose sets 0.0.0.0 and only
# `expose`s the port, so it stays private to the compose network there.
REALTIME_HOST=
# Port the server listens on (realtime.ts:57, default 4001).
REALTIME_PORT=
# Comma-separated origins allowed to make cross-origin socket connections with
# credentials (realtime.ts:119). Unset = same-origin only, which is what a
# normal nginx-proxied deployment wants. Set it only if the browser is served
# from a different origin than the API.
REALTIME_CORS_ORIGIN=
# Any non-empty value logs every socket disconnect and its reason
# (realtime.ts:179). Troubleshooting only — it is per-connection noise.
REALTIME_DEBUG=

# ── Sentry: release and environment tagging ─────────────────────────────────
# DSN, org, project and auth token are documented above; these control how
# events are GROUPED, and getting them wrong is invisible until you need it.
# Both the server and edge configs read these two; the client reads the
# NEXT_PUBLIC_ pair.
# Label attached to every event. Defaults to NODE_ENV, then "development" —
# so a staging box that never sets it reports as whichever NODE_ENV it runs.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Which build produced this error. Without it every deploy's events land in one
# bucket and "this started at the last push" is unanswerable: the server config
# falls back to .next/BUILD_ID (unique per build, useless for comparison), and
# the client has no fallback at all. Set both to the same git SHA per release.
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
# Opt the client/server/edge initialisers out with SENTRY_ENABLE=false.
# SENTRY_DISABLE=true does the same thing; both are honoured because both have
# been documented as the switch in different runbooks (sentry.server.config.ts:52).
SENTRY_ENABLE=
# Telegram webhook registration (scripts/telegram-setup-webhook.ts:14): the
# public URL Telegram should POST to, normally
# https://<your-domain>/api/webhooks/telegram/bot. Must match APP_URL's host.
WEBHOOK_URL=
