# ── File Storage (S3-compatible) ──
# Provide your S3 endpoint, bucket, access key, and secret key
S3_ENDPOINT=<FROM_USER>
S3_BUCKET=<FROM_USER>
S3_ACCESS_KEY=<FROM_USER>
S3_SECRET_KEY=<FROM_USER>
NEXT_PUBLIC_S3_ENDPOINT=<FROM_USER>

# ── Stripe ──
# Leave blank if not using payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email (SMTP) ──
# Provide SMTP credentials
SMTP_HOST=<FROM_USER>
SMTP_PORT=<FROM_USER>
SMTP_USER=<FROM_USER>
SMTP_PASS=<FROM_USER>
EMAIL_FROM=<FROM_USER>

# ── Sentry ──
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

